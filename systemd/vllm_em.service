[Unit]
Description=vLLM embed (bge-m3)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/vllm
ExecStart=/opt/vllm/scripts/vllm_embed.sh
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=90
TimeoutStartSec=900
Restart=on-failure
RestartSec=30
LimitNOFILE=65536
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
